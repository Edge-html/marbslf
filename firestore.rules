rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isMeetupParticipant(data) {
      return signedIn() && (data.owner_id == request.auth.uid || data.finder_id == request.auth.uid);
    }

    function ownsPost(postId) {
      return signedIn()
        && exists(/databases/$(database)/documents/posts/$(postId))
        && get(/databases/$(database)/documents/posts/$(postId)).data.user_id == request.auth.uid;
    }

    match /id_verifications/{verificationId} {
      function validSubmission() {
        return request.resource.data.keys().hasOnly([
            'verification_id', 'user_id', 'full_legal_name', 'id_type',
            'id_image', 'selfie_image', 'camera_verified',
            'selfie_camera_verified', 'consented_to_visual_comparison',
            'consented_at', 'status', 'submitted_at', 'reviewed_by', 'reviewed_at'
          ])
          && request.resource.data.verification_id == verificationId
          && request.resource.data.user_id == request.auth.uid
          && request.resource.data.full_legal_name is string
          && request.resource.data.full_legal_name.size() > 1
          && request.resource.data.id_type is string
          && request.resource.data.id_image is string
          && request.resource.data.id_image.matches('data:image/.*;base64,.*')
          && request.resource.data.selfie_image is string
          && request.resource.data.selfie_image.matches('data:image/.*;base64,.*')
          && request.resource.data.id_image.size() < 450000
          && request.resource.data.selfie_image.size() < 450000
          && request.resource.data.id_image.size() + request.resource.data.selfie_image.size() < 850000
          && request.resource.data.selfie_camera_verified == true
          && request.resource.data.consented_to_visual_comparison == true
          && request.resource.data.status == 'PENDING'
          && request.resource.data.reviewed_by == ''
          && request.resource.data.reviewed_at == '';
      }

      allow create: if signedIn() && validSubmission();
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.user_id == request.auth.uid);
      allow update: if isAdmin()
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'reviewed_by', 'reviewed_at'
          ])
          && request.resource.data.status in ['VERIFIED', 'REJECTED', 'SUSPENDED'])
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'id_image', 'selfie_image', 'images_deleted_at'
          ])
          && resource.data.status in ['VERIFIED', 'REJECTED']
          && request.resource.data.id_image == ''
          && request.resource.data.selfie_image == ''
          && request.resource.data.images_deleted_at is string)
        );
      allow delete: if isAdmin();
    }

    // Abuse reports are private to their author and trusted moderators.
    match /reports/{reportId} {
      function validReport() {
        return request.resource.data.keys().hasOnly([
            'report_id', 'reporter_id', 'reported_user_id', 'reported_post_id', 'reported_message_id',
            'target_type', 'target_id', 'reason', 'details', 'status',
            'admin_action', 'created_at'
          ])
          && reportId.matches('^REP-[A-Za-z0-9-]{12,80}$')
          && request.resource.data.report_id == reportId
          && request.resource.data.reporter_id == request.auth.uid
          && request.resource.data.target_type in ['GENERAL', 'POST', 'USER', 'MESSAGE']
          && request.resource.data.target_id is string
          && request.resource.data.target_id.matches('^[A-Za-z0-9_-]{1,160}$')
          && request.resource.data.target_id.size() <= 160
          && request.resource.data.reported_user_id is string
          && request.resource.data.reported_user_id.size() <= 128
          && request.resource.data.reported_post_id is string
          && request.resource.data.reported_post_id.size() <= 160
          && request.resource.data.reported_message_id is string
          && request.resource.data.reported_message_id.size() <= 160
          && (request.resource.data.target_type != 'POST'
            || request.resource.data.reported_post_id == request.resource.data.target_id)
          && (request.resource.data.target_type != 'USER'
            || (request.resource.data.reported_user_id == request.resource.data.target_id
              && request.resource.data.reported_user_id != request.auth.uid))
          && (request.resource.data.target_type != 'MESSAGE'
            || (request.resource.data.reported_message_id == request.resource.data.target_id
              && request.resource.data.reported_user_id != request.auth.uid
              && exists(/databases/$(database)/documents/messages/$(request.resource.data.target_id))
              && get(/databases/$(database)/documents/messages/$(request.resource.data.target_id)).data.sender_id == request.resource.data.reported_user_id
              && get(/databases/$(database)/documents/messages/$(request.resource.data.target_id)).data.receiver_id == request.auth.uid
              && get(/databases/$(database)/documents/messages/$(request.resource.data.target_id)).data.post_id == request.resource.data.reported_post_id))
          && request.resource.data.reason is string
          && request.resource.data.reason in [
            'Suspicious Reward Request', 'Fake Post', 'Fake Claim', 'Scam',
            'Harassment', 'Incorrect Information', 'Other'
          ]
          && request.resource.data.details is string
          && request.resource.data.details.size() >= 10
          && request.resource.data.details.size() <= 1000
          && request.resource.data.status == 'UNDER_REVIEW'
          && request.resource.data.admin_action == 'Pending administrator inspection'
          && request.resource.data.created_at is string;
      }

      allow create: if signedIn() && validReport();
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.reporter_id == request.auth.uid);
      allow update: if isAdmin()
        && resource.data.status == 'UNDER_REVIEW'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'admin_action', 'resolved_at'
        ])
        && request.resource.data.status in ['RESOLVED', 'DISMISSED']
        && request.resource.data.admin_action is string
        && request.resource.data.admin_action.size() <= 200
        && request.resource.data.resolved_at is string;
      allow delete: if isAdmin();
    }

    // Audit entries are append-only and visible only to Firebase admins.
    match /audit_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'log_id', 'admin_id', 'action_type', 'description', 'timestamp'
        ])
        && request.resource.data.log_id == logId
        && request.resource.data.admin_id == request.auth.uid
        && request.resource.data.action_type is string
        && request.resource.data.action_type.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.timestamp is string;
      allow update, delete: if false;
    }

    // Private schedules remain participant-only. The public archive receives
    // a separate, deliberately sanitized projection after both confirmations.
    match /meetups/{meetupId} {
      allow get, list: if isAdmin() || isMeetupParticipant(resource.data);
      allow create: if isMeetupParticipant(request.resource.data)
        && request.resource.data.meetup_id == meetupId
        && request.resource.data.status == 'CONFIRMED'
        && request.resource.data.owner_id != request.resource.data.finder_id
        && request.resource.data.owner_confirmed_return == false
        && request.resource.data.finder_confirmed_return == false
        && request.resource.data.keys().hasOnly([
          'meetup_id', 'match_id', 'post_id', 'owner_id', 'finder_id',
          'place_id', 'place_name', 'date', 'time', 'status',
          'owner_confirmed_return', 'finder_confirmed_return',
          'safety_acknowledged', 'created_at'
        ]);
      allow update: if isMeetupParticipant(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'owner_confirmed_return', 'finder_confirmed_return', 'status', 'completed_at'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['owner_confirmed_return'])
          || (request.auth.uid == resource.data.owner_id && request.resource.data.owner_confirmed_return == true))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['finder_confirmed_return'])
          || (request.auth.uid == resource.data.finder_id && request.resource.data.finder_confirmed_return == true))
        && request.resource.data.status in ['CONFIRMED', 'COMPLETED']
        && (request.resource.data.status != 'COMPLETED'
          || (request.resource.data.owner_confirmed_return == true
            && request.resource.data.finder_confirmed_return == true));
      allow delete: if isAdmin();
    }

    match /public_transactions/{transactionId} {
      allow get, list: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'public_transaction_id', 'kind', 'category', 'city',
          'completed_month', 'completed_at', 'confirmation'
        ])
        && request.resource.data.public_transaction_id == transactionId
        && exists(/databases/$(database)/documents/meetups/$(transactionId))
        && get(/databases/$(database)/documents/meetups/$(transactionId)).data.status == 'COMPLETED'
        && get(/databases/$(database)/documents/meetups/$(transactionId)).data.owner_confirmed_return == true
        && get(/databases/$(database)/documents/meetups/$(transactionId)).data.finder_confirmed_return == true
        && isMeetupParticipant(get(/databases/$(database)/documents/meetups/$(transactionId)).data)
        && request.resource.data.category in [
          'Pets', 'Electronics', 'Personal Items', 'IDs & Documents',
          'Keys', 'Clothing', 'School Items', 'Others', 'Bags', 'Other'
        ]
        && request.resource.data.kind == (request.resource.data.category == 'Pets' ? 'PET_REUNION' : 'ITEM_RETURN')
        && request.resource.data.city == 'Koronadal City'
        && request.resource.data.completed_month is string
        && request.resource.data.completed_month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.completed_at is string
        && request.resource.data.confirmation == 'Confirmed by both participants';
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create: if isAdmin() || (signedIn()
        && request.auth.uid == userId
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.role == 'USER'
        && request.resource.data.verification_status == 'UNVERIFIED'
        && request.resource.data.points_balance == 50
        && request.resource.data.keys().hasOnly([
          'user_id', 'first_name', 'middle_name', 'last_name', 'public_alias',
          'date_of_birth', 'email', 'phone', 'username', 'barangay', 'province',
          'city', 'account_status', 'verification_status', 'points_balance',
          'role', 'created_at', 'avatar_url', 'rating_avg', 'rating_count'
        ]));
      allow update: if isAdmin() || (signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'first_name', 'middle_name', 'last_name', 'phone', 'username',
          'date_of_birth', 'barangay', 'avatar_url'
        ]));
      allow delete: if isAdmin();
    }

    // This compatibility rule keeps existing non-identity collections working.
    // Identity submissions and user profiles are explicitly excluded above.
    // Other collections should be migrated to least-privilege rules before
    // treating their contents as private.
    match /{collection}/{document=**} {
      allow read, write: if collection != 'id_verifications'
        && collection != 'reports'
        && collection != 'audit_logs'
        && collection != 'users'
        && collection != 'meetups'
        && collection != 'public_transactions';
    }
  }
}
